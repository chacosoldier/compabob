# dictation module config. Copy to modules/dictation/.env (gitignored) and edit.
# Read by proxy.py (the cleanup endpoint) and learn.py (the learning loop).

# --- proxy ---
DICTATION_PORT=8765
# Master kill switch. 0 = proxy returns the raw transcript unchanged (pass-through),
# so dictation keeps working with zero LLM involvement.
DICTATION_ENABLED=1
# Dump the last request body to data/dictation/debug-last-request.json (0/1).
DICTATION_DEBUG=0

# --- upstream cleanup LLM (any OpenAI-compatible endpoint) ---
# Default: Groq. Get a free key at https://console.groq.com
DICTATION_UPSTREAM_BASE=https://api.groq.com/openai/v1
DICTATION_UPSTREAM_MODEL=llama-3.3-70b-versatile
DICTATION_UPSTREAM_KEY=
# Seconds to wait for the upstream. Groq is fast (30 is plenty). A LOCAL model
# (Ollama) can take longer than this on its first call while it loads into
# memory — bump to 120 if you see cold-start passthroughs, then it stays fast.
DICTATION_UPSTREAM_TIMEOUT=30
# Local, no-key alternative (Ollama, keeps text on your machine):
#   DICTATION_UPSTREAM_BASE=http://localhost:11434/v1
#   DICTATION_UPSTREAM_MODEL=llama3.1:8b
#   DICTATION_UPSTREAM_KEY=
# OpenAI:
#   DICTATION_UPSTREAM_BASE=https://api.openai.com/v1
#   DICTATION_UPSTREAM_MODEL=gpt-4o-mini
#   DICTATION_UPSTREAM_KEY=sk-...

# --- learning loop (learn.py) ---
# 0 = propose-only: log candidates but do not write to glossary.yaml.
# 1 = auto-promote recurring corrections into glossary.yaml.
DICTATION_AUTO_PROMOTE=1
# A correction must recur at least this many times to be promoted.
LEARN_MIN_OCCURRENCES=4
# ...and the same wrong->right must hold at least this fraction of the time.
LEARN_MIN_CONSISTENCY=0.9
# Prune calls.jsonl rows older than this many days after each learn run (privacy).
LEARN_RETENTION_DAYS=30
